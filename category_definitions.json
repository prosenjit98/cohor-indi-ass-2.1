  "priority_definitions": {
    "Critical": {
      "description": "System completely down, security breach, or multiple users affected",
      "sla": "Response within 15 minutes",
      "examples": [
        "Complete system outage",
        "Security breach detected",
        "Data loss occurring",
        "Critical business application down affecting multiple users"
      ]
    },
    "High": {
      "description": "Single user unable to work, data loss risk, or urgent business impact",
      "sla": "Response within 2 hours",
      "examples": [
        "Cannot access work computer",
        "Critical business application error for single user",
        "Suspected malware infection",
        "Account locked preventing work"
      ]
    },
    "Medium": {
      "description": "Workaround available, non-urgent but impacting productivity",
      "sla": "Response within 8 hours",
      "examples": [
        "Application running slowly",
        "Minor connectivity issues",
        "Printer not working (alternatives available)",
        "Password reset needed"
      ]
    },
    "Low": {
      "description": "General questions, feature requests, minor inconveniences",
      "sla": "Response within 24 hours",
      "examples": [
        "How-to questions",
        "Feature requests",
        "Minor cosmetic issues",
        "General information requests"
      ]
    }
  },
  "confidence_levels": {
    "high": "Clear and specific issue description with identifiable category",
